{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meethub",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/signal", "/health"],
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://meethub-pink.vercel.app",
    "MAX_PARTICIPANTS": "4",
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "MeetingRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MeetingRoom"] }],
}
