# Leave blank for a same-origin server or local development.
VITE_SIGNALING_URL=
ALLOWED_ORIGINS=https://meethub-pink.vercel.app
PORT=3001
MAX_PARTICIPANTS=4
MAX_ROOMS=50
# Optional JSON array of your own ICE/STUN/TURN settings.
# No paid relay service is enabled by default.
VITE_ICE_SERVERS=[{"urls":"stun:stun.cloudflare.com:3478"}]
# Backend-only relay settings. For the strict Free account, run npm run setup:relay.
# METERED_APP_NAME=your-app-name
# METERED_API_KEY=your-private-turn-api-key
# Alternative: private JSON ICE configuration stored as a backend secret.
# ICE_SERVERS_JSON=
# Cloudflare TURN is optional; do not activate metered billing for a zero-cost deployment.
# TURN_KEY_ID=
# TURN_API_TOKEN=
